{
  "expo": {
    "name": "Lista de tarefas",
    "slug": "lista-de-tarefas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imagem.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/imagem.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.app.listadetarefas",
      "versionCode": 21
    },
    "permissions": [],
    "web": {
      "favicon": "./assets/imagem.png"
    },
    "extra": {
      "eas": {
        "projectId": "77b84a5b-aff0-45b4-826e-abee8e405bda"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font"
    ]
  }
}
